# Events Query API - Environment Variables

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=events_user
DB_PASSWORD=events_password
DB_NAME=events_db
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT=30
OPENAI_MAX_RETRIES=3

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_RELOAD=false

# Application Configuration
APP_NAME=Events Query API
APP_VERSION=1.0.0
APP_DESCRIPTION=API de búsqueda de eventos con lenguaje natural
ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO

# MySQL remoto (Railway u otro): solo para .\run-shift-railway.ps1 y .\run-fake-data-railway.ps1
# Host y puerto PUBLICOS desde el panel del proveedor. No sustituye DB_* de arriba en disco;
# los scripts copian RAILWAY_DB_* -> DB_* solo en ese proceso.
# RAILWAY_DB_HOST=caboose.proxy.rlwy.net
# RAILWAY_DB_PORT=55339
# RAILWAY_DB_USER=root
# RAILWAY_DB_PASSWORD=
# RAILWAY_DB_NAME=railway
