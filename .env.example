# Events Query API - Environment Variables

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=events_user
DB_PASSWORD=events_password
DB_NAME=events_db
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT=30
OPENAI_MAX_RETRIES=3
# Ingesta (listados HTML grandes): timeout más alto que la API
# INGEST_OPENAI_TIMEOUT=120

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_RELOAD=false

# Application Configuration
APP_NAME=Events Query API
APP_VERSION=1.0.0
APP_DESCRIPTION=API de búsqueda de eventos con lenguaje natural
ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO

# MySQL remoto (Railway u otro): solo .\run-shift-railway.ps1 y .\run-fake-data-railway.ps1
# Mapeo Railway (panel MySQL -> Variables) -> tu .env (desde TU PC usa SIEMPRE datos PUBLICOS):
#
#   RAILWAY_DB_HOST     <- host de MYSQL_PUBLIC_URL (ej. caboose.proxy.rlwy.net)
#                         SOLO el hostname, NUNCA la URL completa mysql://...
#                         NO uses MYSQLHOST: es el host INTERNO (mysql.railway.internal).
#   RAILWAY_DB_PORT     <- puerto de MYSQL_PUBLIC_URL (ej. 55339)
#                         NO uses MYSQLPORT: es 3306 solo dentro de Railway.
#   RAILWAY_DB_USER     <- MYSQLUSER
#   RAILWAY_DB_PASSWORD <- MYSQLPASSWORD (o MYSQL_ROOT_PASSWORD si el usuario es root)
#   RAILWAY_DB_NAME     <- MYSQL_DATABASE o MYSQLDATABASE (mismo valor en Railway)
#
#   MYSQL_URL = conexion interna (no usar desde tu maquina).
#   MYSQL_PUBLIC_URL = cadena completa mysql://user:pass@host:puerto/db (puedes copiar host/puerto de aqui).
#
# RAILWAY_DB_HOST=caboose.proxy.rlwy.net
# RAILWAY_DB_PORT=55339
# RAILWAY_DB_USER=root
# RAILWAY_DB_PASSWORD=
# RAILWAY_DB_NAME=railway

# Ops: ingesta remota (python scripts/ingest_all.py --target railway)
# EVENTS_API_BASE_URL=https://eventquery.km0lab.com
# INGEST_UPLOAD_SECRET=un_secreto_largo_aleatorio  # si no, usa RAILWAY_DB_PASSWORD
