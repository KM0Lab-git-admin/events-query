# Copia este archivo a .env.railway (opcional) si no usas RAILWAY_DB_* en tu .env principal.

# Desde tu PC: host y puerto PUBLICOS (MYSQL_PUBLIC_URL en Railway), no mysql.railway.internal
DB_HOST=caboose.proxy.rlwy.net
DB_PORT=55339
DB_USER=root
DB_PASSWORD=tu_password_mysql
DB_NAME=railway

# Obligatorio para cargar app.config
OPENAI_API_KEY=sk-tu-api-key

# --- Alternativa: en tu .env principal puedes usar estas en lugar de este archivo ---
# RAILWAY_DB_HOST=caboose.proxy.rlwy.net
# RAILWAY_DB_PORT=55339
# RAILWAY_DB_USER=root
# RAILWAY_DB_PASSWORD=...
# RAILWAY_DB_NAME=railway
