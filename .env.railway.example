# Copia este archivo a .env.railway (no se sube a Git) y rellena los valores.
# En Railway: servicio MySQL -> Variables / Networking.
# Para ejecutar scripts DESDE TU PC usa host y puerto PUBLICOS (MYSQL_PUBLIC_URL),
# no mysql.railway.internal ni puerto 3306 interno.

DB_HOST=caboose.proxy.rlwy.net
DB_PORT=55339
DB_USER=root
DB_PASSWORD=tu_password_mysql
DB_NAME=railway

# Obligatorio para cargar app.config al importar el proyecto
OPENAI_API_KEY=sk-tu-api-key
